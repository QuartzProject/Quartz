option(QUARTZ_WERROR "Treat warnings as errors" OFF)
set(QUARTZ_SANITIZE "" CACHE STRING "Comma separated sanitizers (address,undefined,thread)")
option(QUARTZ_FUZZ "Build libFuzzer targets" OFF)
# Optional parts are AUTO (built when their tools are found), ON (a configure error without them) or OFF.
set(QUARTZ_COMPILER AUTO CACHE STRING "The LLVM native tier (quartz-compiler): AUTO, ON or OFF")
set(QUARTZ_JVM AUTO CACHE STRING "Java and Kotlin bindings, built and tested with Gradle against libquartz: AUTO, ON or OFF")
set(QUARTZ_ANDROID AUTO CACHE STRING "The Android part of the JVM bindings (needs the SDK and an NDK): AUTO, ON or OFF")
set_property(CACHE QUARTZ_COMPILER QUARTZ_JVM QUARTZ_ANDROID PROPERTY STRINGS AUTO ON OFF)
option(QUARTZ_SHARED "Build libquartz, a shared library with the C interface" OFF)
if(QUARTZ_SHARED)
    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
endif()

find_program(QUARTZ_CCACHE ccache)
if(QUARTZ_CCACHE)
    set(CMAKE_CXX_COMPILER_LAUNCHER ${QUARTZ_CCACHE})
    set(CMAKE_C_COMPILER_LAUNCHER ${QUARTZ_CCACHE})
endif()

add_library(quartz_options INTERFACE)
add_library(quartz::options ALIAS quartz_options)
target_compile_features(quartz_options INTERFACE cxx_std_23)
# Deterministic floats (D24): never contract a*b+c into an FMA. Installed consumers get only the language level.
set(quartz_flags -ffp-contract=off -fno-rtti -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wno-sign-conversion
    -Wnon-virtual-dtor -Wimplicit-fallthrough)
set(quartz_link_flags)
if(QUARTZ_WERROR)
    list(APPEND quartz_flags -Werror)
endif()
if(QUARTZ_FUZZ)
    list(APPEND quartz_flags -fsanitize=fuzzer-no-link)
endif()
if(QUARTZ_SANITIZE)
    list(APPEND quartz_flags -fsanitize=${QUARTZ_SANITIZE} -fno-omit-frame-pointer)
    list(APPEND quartz_link_flags -fsanitize=${QUARTZ_SANITIZE})
endif()
target_compile_options(quartz_options INTERFACE "$<BUILD_INTERFACE:${quartz_flags}>")
target_link_options(quartz_options INTERFACE "$<BUILD_INTERFACE:${quartz_link_flags}>")

# The C++ interface includes headers from src/; an installed tree keeps them under include/quartz/detail.
function(quartz_module name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS" ${ARGN})
    add_library(${name} STATIC ${ARG_SOURCES})
    target_include_directories(${name} PUBLIC $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
        $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src> $<INSTALL_INTERFACE:include> $<INSTALL_INTERFACE:include/quartz/detail>)
    target_link_libraries(${name} PUBLIC quartz::options ${ARG_DEPS})
endfunction()

# `<target>_pic`: the same static library built position independent, linking the copies of its dependencies.
function(quartz_pic_copies)
    foreach(name IN LISTS ARGN)
        get_target_property(sources ${name} SOURCES)
        get_target_property(dir ${name} SOURCE_DIR)
        list(TRANSFORM sources PREPEND "${dir}/" REGEX "^[^/]")
        add_library(${name}_pic STATIC EXCLUDE_FROM_ALL ${sources})
        set_target_properties(${name}_pic PROPERTIES POSITION_INDEPENDENT_CODE ON)
        foreach(property INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
                         COMPILE_DEFINITIONS COMPILE_OPTIONS)
            get_target_property(value ${name} ${property})
            if(value)
                set_target_properties(${name}_pic PROPERTIES ${property} "${value}")
            endif()
        endforeach()
        get_target_property(deps ${name} LINK_LIBRARIES)
        if(NOT deps)
            set(deps)
        endif()
        set(mapped)
        foreach(dep IN LISTS deps)
            if(TARGET ${dep}_pic)
                list(APPEND mapped ${dep}_pic)
            else()
                list(APPEND mapped ${dep})
            endif()
        endforeach()
        target_link_libraries(${name}_pic PUBLIC ${mapped})
    endforeach()
endfunction()

function(quartz_test name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE quartz::options quartz_doctest ${ARG_DEPS})
    add_test(NAME ${name} COMMAND ${name} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
endfunction()

function(quartz_fuzzer name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS" ${ARGN})
    add_executable(${name} ${ARG_SOURCES})
    target_link_libraries(${name} PRIVATE quartz::options ${ARG_DEPS})
    target_link_options(${name} PRIVATE -fsanitize=fuzzer)
endfunction()
