# The optional parts (D156): each AUTO/ON/OFF option becomes <OPTION>_ENABLED, with one status line saying why.

# Sets <option>_ENABLED from the option and whether its tool was found; ON without the tool stops the configure.
function(quartz_optional option what found detail missing)
    string(TOUPPER "${${option}}" mode)
    if(mode STREQUAL "AUTO" OR mode STREQUAL "")
        set(enabled ${found})
    elseif(${option})
        if(NOT found)
            message(FATAL_ERROR "${option}=ON but ${missing}")
        endif()
        set(enabled TRUE)
    else()
        set(enabled FALSE)
    endif()
    if(enabled)
        message(STATUS "Quartz: ${what} ON (${detail})")
    elseif(mode STREQUAL "AUTO" OR mode STREQUAL "")
        message(STATUS "Quartz: ${what} OFF (${missing})")
    else()
        message(STATUS "Quartz: ${what} OFF (${option}=${${option}})")
    endif()
    set(${option}_ENABLED ${enabled} PARENT_SCOPE)
endfunction()

function(quartz_wanted option out)
    string(TOUPPER "${${option}}" mode)
    if(mode STREQUAL "AUTO" OR mode STREQUAL "" OR ${option})
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

# LLVM 23: llvm-config on native builds, its CMake package on Windows and cross builds (as compiler/ uses them).
set(quartz_llvm_found FALSE)
set(quartz_llvm_version "")
quartz_wanted(QUARTZ_COMPILER quartz_want_llvm)
if(quartz_want_llvm AND NOT CMAKE_DISABLE_FIND_PACKAGE_LLVM)
    if(WIN32 OR CMAKE_CROSSCOMPILING)
        find_package(LLVM CONFIG QUIET)
        if(LLVM_FOUND AND LLVM_VERSION_MAJOR EQUAL 23)
            set(quartz_llvm_found TRUE)
            set(quartz_llvm_version ${LLVM_PACKAGE_VERSION})
        endif()
    else()
        find_program(QUARTZ_LLVM_CONFIG NAMES llvm-config-23 llvm-config)
        if(QUARTZ_LLVM_CONFIG)
            execute_process(COMMAND ${QUARTZ_LLVM_CONFIG} --version OUTPUT_VARIABLE quartz_llvm_version
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(quartz_llvm_version MATCHES "^23\\.")
                set(quartz_llvm_found TRUE)
            endif()
        endif()
    endif()
endif()
quartz_optional(QUARTZ_COMPILER "native tier" ${quartz_llvm_found} "LLVM ${quartz_llvm_version}"
    "no LLVM 23 found")

# A JDK 22 or newer runs the Gradle wrapper of bindings/jvm (the FFM API the bindings use is final since 22).
set(quartz_jdk_found FALSE)
quartz_wanted(QUARTZ_JVM quartz_want_jdk)
if(quartz_want_jdk AND NOT CMAKE_DISABLE_FIND_PACKAGE_Java)
    find_package(Java 22 QUIET COMPONENTS Development)
    if(Java_FOUND AND Java_JAVAC_EXECUTABLE)
        set(quartz_jdk_found TRUE)
        file(REAL_PATH "${Java_JAVAC_EXECUTABLE}" quartz_javac)
        cmake_path(GET quartz_javac PARENT_PATH quartz_jdk_bin)
        cmake_path(GET quartz_jdk_bin PARENT_PATH QUARTZ_JDK_HOME)
    endif()
endif()
quartz_optional(QUARTZ_JVM "JVM bindings" ${quartz_jdk_found} "JDK ${Java_VERSION_MAJOR}" "no JDK 22+ found")

# Android: the SDK (ANDROID_HOME) and an NDK (ANDROID_NDK_HOME, or the newest one inside the SDK).
set(quartz_ndk_found FALSE)
set(QUARTZ_ANDROID_NDK "")
set(quartz_ndk_missing "no Android SDK and NDK found")
if(NOT QUARTZ_JVM_ENABLED)
    set(quartz_ndk_missing "needs the JVM bindings")
elseif(DEFINED ENV{ANDROID_HOME} OR DEFINED ENV{ANDROID_SDK_ROOT})
    set(quartz_sdk "$ENV{ANDROID_HOME}")
    if(NOT quartz_sdk)
        set(quartz_sdk "$ENV{ANDROID_SDK_ROOT}")
    endif()
    if(DEFINED ENV{ANDROID_NDK_HOME} AND IS_DIRECTORY "$ENV{ANDROID_NDK_HOME}")
        set(QUARTZ_ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
    else()
        file(GLOB quartz_ndks LIST_DIRECTORIES TRUE "${quartz_sdk}/ndk/*")
        list(SORT quartz_ndks COMPARE NATURAL ORDER DESCENDING)
        list(LENGTH quartz_ndks quartz_ndk_count)
        if(quartz_ndk_count GREATER 0)
            list(GET quartz_ndks 0 QUARTZ_ANDROID_NDK)
        endif()
    endif()
    if(QUARTZ_ANDROID_NDK AND EXISTS "${QUARTZ_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
        set(quartz_ndk_found TRUE)
    endif()
endif()
cmake_path(GET QUARTZ_ANDROID_NDK FILENAME quartz_ndk_name)
quartz_optional(QUARTZ_ANDROID "Android bindings" ${quartz_ndk_found} "NDK ${quartz_ndk_name}" "${quartz_ndk_missing}")
