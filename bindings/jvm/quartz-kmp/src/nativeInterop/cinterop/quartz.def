headers = quartz/quartz.h
headerFilter = quartz/quartz.h
package = org.quartzlang.kmp.cinterop
staticLibraries = libquartz_kmp.a
linkerOpts = -lm -lpthread -ldl

---

// qz_slot crosses as a uint64_t so Kotlin never builds a CValue for it.
static inline const char* qzk_str(uint64_t bits, size_t* length) {
    qz_slot s;
    s.u = bits;
    return qz_str(s, length);
}

static inline uint64_t qzk_sandbox_str(qz_sandbox* sandbox, const char* utf8, size_t length) {
    return qz_sandbox_str(sandbox, utf8, length).u;
}

static inline uint64_t qzk_call_str(qz_call* call, const char* utf8, size_t length) {
    return qz_call_str(call, utf8, length).u;
}

static inline uint64_t qzk_sandbox_str_lossy(qz_sandbox* sandbox, const char* text, size_t length) {
    return qz_sandbox_str_lossy(sandbox, text, length).u;
}

static inline uint64_t qzk_call_str_lossy(qz_call* call, const char* text, size_t length) {
    return qz_call_str_lossy(call, text, length).u;
}

static inline uint64_t qzk_sandbox_bytes(qz_sandbox* sandbox, const uint8_t* data, size_t length) {
    return qz_sandbox_bytes(sandbox, data, length).u;
}

static inline uint64_t qzk_call_bytes(qz_call* call, const uint8_t* data, size_t length) {
    return qz_call_bytes(call, data, length).u;
}

static inline qz_status qzk_resume(qz_sandbox* sandbox, uint32_t task, uint64_t bits, qz_task_outcome* outcome) {
    qz_slot s;
    s.u = bits;
    return qz_sandbox_resume(sandbox, task, s, outcome);
}

static inline uint64_t qzk_sandbox_list(qz_sandbox* sandbox, uint32_t type) {
    return qz_sandbox_list(sandbox, type).u;
}

static inline bool qzk_list_push(qz_sandbox* sandbox, uint64_t list, const uint64_t* element, size_t slots) {
    qz_slot l;
    l.u = list;
    return qz_list_push(sandbox, l, (const qz_slot*)element, slots);
}

static inline uint64_t qzk_sandbox_map(qz_sandbox* sandbox, uint32_t type) {
    return qz_sandbox_map(sandbox, type).u;
}

static inline bool qzk_map_set(qz_sandbox* sandbox, uint64_t map, const uint64_t* key, const uint64_t* value) {
    qz_slot m;
    m.u = map;
    return qz_map_set(sandbox, m, (const qz_slot*)key, (const qz_slot*)value);
}

static inline size_t qzk_map_length(uint64_t map) {
    qz_slot m;
    m.u = map;
    return qz_map_length(m);
}

static inline bool qzk_map_entry(qz_sandbox* sandbox, uint64_t map, size_t index, uint64_t* key, uint64_t* value) {
    qz_slot m;
    m.u = map;
    return qz_map_entry(sandbox, m, index, (qz_slot*)key, (qz_slot*)value);
}

static inline size_t qzk_list_length(uint64_t list) {
    qz_slot l;
    l.u = list;
    return qz_list_length(l);
}

static inline bool qzk_list_get(uint64_t list, size_t index, qz_slot* out, size_t slots) {
    qz_slot l;
    l.u = list;
    return qz_list_get(l, index, out, slots);
}
