headers = quartz/quartz.h
headerFilter = quartz/quartz.h
package = org.quartzlang.kmp.cinterop
staticLibraries = libquartz_kmp.a
linkerOpts = -lm -lpthread -ldl

---

// qz_slot crosses as a uint64_t so Kotlin never builds a CValue for it.
static inline const char* qzk_str(uint64_t bits, size_t* length) {
    qz_slot s;
    s.u = bits;
    return qz_str(s, length);
}

static inline uint64_t qzk_sandbox_str(qz_sandbox* sandbox, const char* utf8, size_t length) {
    return qz_sandbox_str(sandbox, utf8, length).u;
}

static inline uint64_t qzk_call_str(qz_call* call, const char* utf8, size_t length) {
    return qz_call_str(call, utf8, length).u;
}

static inline qz_status qzk_resume(qz_sandbox* sandbox, uint32_t task, uint64_t bits, qz_task_outcome* outcome) {
    qz_slot s;
    s.u = bits;
    return qz_sandbox_resume(sandbox, task, s, outcome);
}

static inline uint64_t qzk_sandbox_list(qz_sandbox* sandbox, uint32_t type) {
    return qz_sandbox_list(sandbox, type).u;
}

static inline bool qzk_list_push(qz_sandbox* sandbox, uint64_t list, uint64_t element) {
    qz_slot l;
    qz_slot e;
    l.u = list;
    e.u = element;
    return qz_list_push(sandbox, l, &e, 1);
}

static inline size_t qzk_list_length(uint64_t list) {
    qz_slot l;
    l.u = list;
    return qz_list_length(l);
}

static inline bool qzk_list_get(uint64_t list, size_t index, qz_slot* out, size_t slots) {
    qz_slot l;
    l.u = list;
    return qz_list_get(l, index, out, slots);
}
