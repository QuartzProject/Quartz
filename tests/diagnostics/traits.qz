trait Eq {
    fn same(self) -> bool
}

trait Weight {
    fn weight(self) -> int
    fn heavy(self) -> bool {
        return self.weight() > 10
    }
}

struct Rock {
    kg: int
}

impl Weight for Rock {}

struct Pile<T: Weight> {
    items: [T]
}

fn names(p: Pile<str>) -> int {
    return 0
}

@derive(Hash)
struct F {
    x: float
}

impl Hash for Rock {}

@derive(Ord, Iterator)
struct O {
    n: int
}

@derive(Eq)
struct E {
    n: int
}

fn misuse(r: Rock, a: E, b: E, m: Map<Rock, int>) -> bool {
    let t = "{r}"
    return a < b
}

struct Bad {
    n: int
}

impl Iterator for Bad {
    fn next(self) -> int? {
        return null
    }
}

fn loops(e: E) {
    for x in e {
    }
}

fn specs(f: float, n: int, s: str) -> str {
    return "{n:5z} {f:x} {n:.2} {s:+}"
}
