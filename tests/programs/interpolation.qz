// expect: [3.14] [   3.142] [3.1     ] [    3    ] [-3.142] [+0003.14]
// expect: [   42] [42   ] [  42  ] [00042] [-0255] [+42] [****42]
// expect: [ff] [FF] [101] [10] [-ff] [##2a###]
// expect: [   hi] [hi---] [ééééé] [  true] [    P(x=1)] [2] [4] [0.10000000000000000555]
// expect: [ffffffffffffffff] [-80] [-0.0] [1000000000000000000000.0]
@derive(Show)
struct P {
    x: int
}

fn main() -> int {
    let pi = 3.14159265
    let n = 42
    let neg = -255
    print("[{pi:.2}] [{pi:8.3}] [{pi:<8.1}] [{pi:^9.0}] [{-pi:+.3}] [{pi:+08.2}]")
    print("[{n:5}] [{n:<5}] [{n:^6}] [{n:05}] [{neg:05}] [{n:+}] [{n:*>6}]")
    print("[{255:x}] [{255:X}] [{5:b}] [{8:o}] [{neg:x}] [{n:#^7x}]")
    print("[{"hi":>5}] [{"hi":-<5}] [{'é':é^5}] [{true:>6}] [{P(1):>10}] [{2.5:.0}] [{3.5:.0}] [{0.1:.20}]")
    let big: u64 = 18446744073709551615
    let small: i8 = -128
    print("[{big:x}] [{small:x}] [{-0.0:.1}] [{1e21:.1}]")
    return 0
}
