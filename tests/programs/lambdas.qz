// expect: 6 v1,v2,v3
// expect: after wait: hi6
// expect: 2,5,8 9
// expect: 24

fn double(x: int) -> int {
    return x * 2
}

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn apply(f: fn(int) -> int, x: int) -> int {
    return f(x)
}

fn adder(k: int) -> fn(int) -> int {
    return (x) => x + k
}

fn twice(f: fn(int) -> int) -> fn(int) -> int {
    return (x) => f(f(x))
}

fn map<T, U>(xs: [T], f: fn(T) -> U) -> [U] {
    let out: [U] = []
    for x in xs {
        out.push(f(x))
    }
    return out
}

fn filter<T>(xs: [T], keep: fn(T) -> bool) -> [T] {
    let out: [T] = []
    for x in xs {
        if keep(x) {
            out.push(x)
        }
    }
    return out
}

fn sortBy<T>(xs: [T], less: fn(T, T) -> bool) {
    for i in 1..xs.len() {
        var j = i
        while j > 0 && less(xs[j], xs[j - 1]) {
            let t = xs[j]
            xs[j] = xs[j - 1]
            xs[j - 1] = t
            j -= 1
        }
    }
}

fn first<T>(xs: [T]) -> T {
    return xs[0]
}

fn each(xs: [int], f: fn(int)) {
    for x in xs {
        f(x)
    }
}

struct Button {
    label: str
    onClick: fn(int) -> str
}

struct Counter {
    n: int
}

impl Counter {
    fn scaler(self) -> fn(int) -> int {
        return (x) => x * self.n
    }
}

state Hub {
    total: int = 0
    names: [str] = []
}

fn bump(hub: Hub) -> fn() {
    return () => {
        hub.total += 1
    }
}

fn record(hub: Hub) {
    each([1, 2, 3], (x) => {
        hub.total += x
        hub.names.push("v{x}")
    })
}

suspend fn main(hub: Hub) -> int {
    let add5 = adder(5)
    print("{apply(double, 21)} {add5(10)} {apply(twice(adder(3)), 0)} {apply(fib, 10)}")
    let odd = filter([1, 2, 3, 9, 4], (n) => n % 2 == 1)
    print("{map([1, 2, 3], (n) => "n{n}").join(",")} {odd.len()} {map(odd, (n) => "{n}").join(",")}")
    let prefix = "p"
    let fs: [fn(int) -> str] = []
    for i in 0..3 {
        fs.push((x) => "{prefix}{i}:{x}")
    }
    print("{fs[0](7)} {fs[1](7)} {fs[2](7)}")
    let ops: Map<str, fn(int) -> int> = Map()
    ops["d"] = double
    ops["sq"] = (x: int) => x * x
    print("{Button("ok", (n) => "clicked {n}").onClick(3)} {ops["sq"](9)} {ops["d"](9)}")
    let pick = first::<str>
    let head: fn([int]) -> int = first
    let nested = (a: int) => (b: int) => a * 100 + b
    print("{Counter(3).scaler()(5)} {pick(["a", "b"])} {head([7, 8])} {twice((x) => x * 2)(5)} {nested(4)(2)}")
    var acc = ""
    var keep: [fn() -> str] = []
    var later: fn() -> str = () => "never"
    scope {
        let tmp = "in{1 + 1}"
        acc = (() => tmp + "!")()
        let s = "scoped{7}"
        keep.push(() => s)
        let t = "later{8}"
        later = () => t
    }
    print("{acc} {keep[0]()} {later()}")
    record(hub)
    print("{hub.total} {hub.names.join(",")}")
    hub.names[0] = "hi{hub.total}"
    let firstName = hub.names[0]
    let greet = () => "after wait: {firstName}"
    hub.names[0] = "changed"
    wait 1.ticks
    print(greet())
    let points = [8, 2, 5]
    sortBy(points, (a, b) => a < b)
    let sum = (xs: [int]) => {
        var s = 0
        for x in xs {
            s += x
        }
        if s > 100 {
            return 0
        }
        s - 6
    }
    print("{map(points, (p) => "{p}").join(",")} {sum(points)}")
    let more = bump(hub)
    var seen = 0
    for _ in 0..3 {
        more()
        seen += hub.total
    }
    print("{seen}")
    return hub.total
}
