// expect: true false false true false
// expect: -1 1 0 true true false
// expect: {a=[4], b=[2, 3]} {} {(1, x)=null} {k=v}
// expect: Row(cells=[1, 2]) true true
// expect: [Row(cells=[0, 9]), Row(cells=[1]), Row(cells=[1, 0])] Row(cells=[0, 9]) Row(cells=[1, 0]) [1, 2, 3] 3 null
@derive(Eq, Ord, Show)
struct Row {
    cells: [int]
}

fn main() -> int {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let c = [1, 2]
    print("{a == b} {a == c} {a != b} {[[1], [2]] == [[1], [2]]} {[0.5] == [1.5]}")
    print("{c.cmp(a)} {a.cmp(c)} {a.cmp(b)} {[1, 2] < [1, 3]} {["b"] > ["a", "z"]} {a < c}")
    var m: Map<str, [int]> = Map()
    m["a"] = [1]
    m["b"] = [2, 3]
    m["a"] = [4]
    let empty: Map<int, int> = Map()
    var t: Map<(int, str), int?> = Map()
    t[(1, "x")] = null
    var s: Map<str, str> = Map()
    s["k"] = "v"
    print("{m} {empty} {t} {s.show()}")
    print("{Row([1, 2])} {Row([1]) < Row([1, 0])} {Row([2]) == Row([2])}")
    let rows = [Row([1, 0]), Row([0, 9]), Row([1])]
    let none: [Row] = []
    rows.sort()
    print("{rows} {rows.min()} {[Row([1, 0]), Row([1])].max()} {[3, 1, 2].sorted()} {[3, 1, 2].max()} {none.min()}")
    return 0
}
