// expect: 4 2 0
// expect: 1 2 3
enum Wrap {
    W(int, int)
}

enum Chain {
    Cons(int, Chain?)
}

enum Opt<T> {
    None
    Some(T, Opt<T>)
}

struct Box<T> {
    a: Opt<T>
    b: T
}

fn first(w: Wrap) -> int {
    let W(a, _) = w
    return a
}

fn second(c: Chain) -> int {
    let Cons(_, rest) = c
    return match rest {
        null => 0
        Cons(v, _) => v
    }
}

fn main() -> int {
    print("{first(Wrap.W(4, 5))} {second(Chain.Cons(1, Chain.Cons(2, null)))} {second(Chain.Cons(1, null))}")
    var o = Opt.Some(1, Opt.Some(2, Opt.None))
    var out = ""
    while o is Some(v, rest) {
        out += "{v} "
        o = rest
    }
    let x = Box(Opt.None, 3)
    print(out + "{x.b}")
    return 0
}
