// expect: 94 2cbeeffffffffffffffffffffffffe3fc00000bfb999999999999a68c3a900017f8001ac02808001ffffffffffffffffff01ffffffffffffffff7f0001027f8001ffffffffffffffffff0100ddc701ffffffff0fffffffff078080808008
// expect: 44 48879 -1 -2 1.5 -0.1 hé
// expect: 0 1 127 128 300 16384 -1 9223372036854775807 0 -1 1 -64 64 -9223372036854775808 0 25565 -1 2147483647 -2147483648 0 true
// expect: 513 1027 -1 false 14 true 14
// expect: bits 4607182418800017408 1036831949 -1.0 false

import org.quartzlang.bytes.*

fn main() -> int {
    let w = ByteWriter(bigEndian = true)
    w.writeU8(300)
    w.writeU16(0xBEEF)
    w.writeU32(-1)
    w.writeI64(-2)
    w.writeF32(1.5)
    w.writeF64(-0.1)
    w.writeStr("hé")
    for v in [0, 1, 127, 128, 300, 16384, -1, 9223372036854775807] {
        w.writeVarUInt(v)
    }
    for v in [0, -1, 1, -64, 64, -9223372036854775807 - 1] {
        w.writeVarInt(v)
    }
    for v in [0, 25565, -1, 2147483647, -2147483648] {
        w.writeVarInt32(v)
    }
    let b = w.toBytes()
    print("{b.len()} {b.hex()}")
    let r = ByteReader(b, bigEndian = true)
    print("{r.readU8().unwrap()} {r.readU16().unwrap()} {r.readI32().unwrap()} {r.readI64().unwrap()} {r.readF32().unwrap()} {r.readF64().unwrap()} {r.readStr(3).unwrap()}")
    var xs: [str] = []
    for i in 0..8 {
        xs.push("{r.readVarUInt().unwrap()}")
    }
    for i in 0..6 {
        xs.push("{r.readVarInt().unwrap()}")
    }
    for i in 0..5 {
        xs.push("{r.readVarInt32().unwrap()}")
    }
    print("{xs.join(" ")} {r.remaining()} {r.readU8().isErr()}")
    let le = ByteReader(bytesOf([1, 2, 3, 4, 255, 255, 255, 255, 255, 255, 255, 255, 255, 2]))
    print("{le.readU16().unwrap()} {le.readI16().unwrap()} {le.readI32().unwrap()} {le.readVarUInt().isErr()} {le.position()} {le.readBytes(99).isErr()} {le.position()}")
    print("bits {floatToBits(1.0)} {f32ToBits(0.1)} {floatFromBits(-4616189618054758400)} {f32FromBits(f32ToBits(0.1)) == 0.1}")
    return 0
}
