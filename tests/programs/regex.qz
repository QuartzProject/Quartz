import org.quartzlang.regex.*

fn spans(m: Match) -> str {
    var out: [str] = []
    for i in 0..m.groupCount() + 1 {
        if let s = m.span(i) {
            out.push("{s.0}-{s.1}")
        } else {
            out.push("x")
        }
    }
    return out.join(",")
}

fn find(i: int, pattern: str, text: str) {
    let r = compileRegex(pattern).unwrap()
    var first = "none"
    if let m = r.find(text) {
        first = spans(m)
    }
    var all: [str] = []
    for m in r.findAll(text) {
        all.push("{m.start}-{m.end}")
    }
    let full = if r.fullMatch(text) { "1" } else { "0" }
    print("find {i} {first} | {all.join(" ")} | {full}")
}

fn replace(i: int, pattern: str, text: str, replacement: str) {
    let r = compileRegex(pattern).unwrap()
    print("replace {i} {r.replace(text, replacement)} | {r.replaceAll(text, replacement)}")
}

fn split(i: int, pattern: str, text: str, limit: int) {
    print("split {i} {compileRegex(pattern).unwrap().split(text, limit).join("|")}")
}

fn error(pattern: str) {
    match compileRegex(pattern) {
        Ok(_) => print("compiled {pattern}")
        Err(e) => print(e)
    }
}

fn errors() {
    for p in ["a(b", "a)b", "[a-", "[z-a]", "*a", "a**", "a\{2}\{3}", "a\{1001}", "a\{3,2}", "(?P<1x>a)", "(?<n>a)(?<n>b)", "(a)\\1", "(?=a)", "(?<!a)b", "\\p\{L}", "\\q", "a\\", "(?x)a", "[[:alpha:]]", "\\x\{110000}", "^*", "((((((((((a))))))))))", "(?i)", "a\{,2}", "x\{1}"] {
        error(p)
    }
    var deep = ""
    for _ in 0..201 {
        deep = deep + "("
    }
    error(deep)
    error("(a\{1000})\{1000}")
}

fn api() {
    let r = compileRegex("(?P<user>\\w+)@(?<host>[\\w.]+)").unwrap()
    let m = r.find("write to ada@example.org today").unwrap()
    print("{m.start} {m.end} {m.text} {m.named("user") ?? "-"} {m.named("host") ?? "-"} {m.group(0) ?? "-"} {r.groupCount()}")
    let opt = compileRegex("(a)|(b)").unwrap().find("b").unwrap()
    print("{opt.group(1) ?? "null"} {opt.group(2) ?? "null"}")
    print(escapeRegex("1+1=2? [a] \{b} (c) ^$ a|b \\ ."))
    let lit = compileRegex(escapeRegex("1+1=2? [a] \{b} (c) ^$ a|b \\ .")).unwrap()
    print("{lit.fullMatch("1+1=2? [a] \{b} (c) ^$ a|b \\ .")} {lit.isMatch("1+1=2")}")
    print("{compileRegex("^\\d+$").unwrap().isMatch("12\n")} {compileRegex("(?m)^\\d+$").unwrap().isMatch("12\n")}")
}

state Kept {
    pattern: Regex = compileRegex("k(\\d)").unwrap()
}

fn kept(k: Kept) {
    print(k.pattern.replaceAll("k1 k2", "<$1>"))
}

fn main(k: Kept) -> int {
    errors()
    api()
    kept(k)
    find(0, "abc", "xxabcxxabc")
    find(1, "a|ab", "ab")
    find(2, "(a|ab)(c|bcd)(d*)", "abcd")
    find(3, "(a+)(b+)?", "aaac")
    find(4, "(a*)*", "b")
    find(5, "(a*)+", "b")
    find(6, "(a|b)*c", "abac")
    find(7, "x*", "abxd")
    find(8, "a*?", "aaa")
    find(9, "a+?b", "aaab")
    find(10, "(?:ab)\{2,3\}", "abababab")
    find(11, "a\{2\}", "aaaaa")
    find(12, "a\{2,\}", "aaaaa")
    find(13, "a\{1,2\}?", "aaa")
    find(14, "[a-c]+", "xxabcabd")
    find(15, "[^a-c]+", "abcxyzabc")
    find(16, "[]a]+", "]a]b")
    find(17, "[a-]+", "a-a-b")
    find(18, "\\d+", "abc 123 45")
    find(19, "\\w+", "hello, world_1!")
    find(20, "\\s+", "a \t\n\u{b} b")
    find(21, "\\D\\W\\S", "a1 .b")
    find(22, "\\bfoo\\b", "foo foobar barfoo foo")
    find(23, "\\Boo\\B", "foo boot")
    find(24, "^abc", "abc\nabc")
    find(25, "(?m)^abc$", "abc\nabc\nab")
    find(26, "abc$", "abcabc")
    find(27, "(?s)a.b", "a\nb")
    find(28, "a.b", "a\nb")
    find(29, "(?i)hello", "HeLLo hello")
    find(30, "(?i)[a-c]+", "ABCabcD")
    find(31, "(?i:a)b", "Ab AB ab")
    find(32, "(?P<year>\\d\{4\})-(?<month>\\d\{2\})", "on 2024-05-17")
    find(33, "\\x41\\x42", "zABz")
    find(34, "a.c", "abc aéc a😀c")
    find(35, "é+", "xééé")
    find(36, "[à-ü]+", "xàéüy")
    find(37, "[^a]", "é")
    find(38, "^.$", "😀")
    find(39, "", "abc")
    find(40, "\\.", "a.b.c")
    find(41, "(a)|(b)", "b")
    find(42, "(?:(a)|b)+", "ab")
    find(43, "(a+)+b", "aaaaaaaaaaaaaaaaac")
    find(44, "\\$\\d+\\.\\d\\d", "cost $12.50 or $3.00")
    find(45, "(a|)+b", "aab")
    find(46, "((a)|b)*?c", "abc")
    find(47, "\\Aab|b\\z", "abab")
    find(48, "(?m)$", "a\nb")
    find(49, "[\\d\\s]+", "a1 2b")
    find(50, "[^\\w]", "ab-c")
    find(51, "(?i)ß|é", "É é")
    find(52, "(?-i:a)", "Aa")
    find(53, "a\{0\}b", "ab")
    find(54, "(?:a?)\{3\}", "aa")
    find(55, "(?s:.)+", "a\nb")
    replace(0, "(\\w+)@(\\w+)", "a@b c@d", "$2 at $1")
    replace(1, "(?P<k>\\w+)=(?P<v>\\w+)", "x=1;y=2", "$\{v\}=$\{k\}")
    replace(2, "a|(b)", "ab", "[$1]")
    replace(3, "\\s+", "  a  b  ", " ")
    replace(4, "", "abc", "-")
    replace(5, "x*", "abxd", "-")
    replace(6, "\\d", "a1b2", "$$")
    replace(7, "(\\d)(\\d)", "1234", "$\{2\}$\{1\}")
    replace(8, "é", "café é", "e")
    replace(9, "a*", "baaa", "<$0>")
    split(0, ",\\s*", "a, b,c,,d", 0)
    split(1, "x*", "axbc", 0)
    split(2, "\\d", "a1b2c3", 0)
    split(3, "", "abc", 0)
    split(4, "b", "abc", 0)
    split(5, ",", "a,b,c,d", 2)
    split(6, ",", "a,b,c,d", 1)
    split(7, "\\s+", " a b ", 0)
    return 0
}
