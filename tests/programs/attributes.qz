// expect: joined 7
// expect: 12 5
// warning: 'half' is deprecated: divide by 2 instead

struct JoinEvent {
    level: int
    name: str
}

@on(PlayerJoin, priority = High, where = event.level > 3)
fn onJoin(event: JoinEvent) {
    print("joined {event.level}")
}

@command("heal", perm = "example.heal")
fn heal(amount: int) -> bool {
    return amount > 0
}

@inline
fn twice(x: int) -> int {
    return x * 2
}

@noinline
@deprecated("divide by 2 instead")
fn half(x: int) -> int {
    return x / 2
}

fn main() -> int {
    onJoin(JoinEvent(7, "Steve"))
    print("{twice(6)} {half(10)}")
    return 0
}
