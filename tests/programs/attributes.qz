// expect: joined 7
// expect: 12 5

struct JoinEvent {
    level: i64
    name: str
}

@on(PlayerJoin, priority = High, where = event.level > 3)
fn onJoin(event: JoinEvent) {
    print("joined {event.level}")
}

@command("heal", perm = "basalt.heal")
fn heal(amount: i64) -> bool {
    return amount > 0
}

@inline
fn twice(x: i64) -> i64 {
    return x * 2
}

@noinline
fn half(x: i64) -> i64 {
    return x / 2
}

fn main() -> i64 {
    onJoin(JoinEvent(7, "Steve"))
    print("{twice(6)} {half(10)}")
    return 0
}
