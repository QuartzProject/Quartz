// expect: 21 ok
// expect: error: bad digit x
// expect: 7 0 true false
// expect: 5 9
// expect: Err(neg) Ok(4) null

enum ParseError {
    Empty
    BadDigit(str)
}

fn describe(e: ParseError) -> str {
    return match e {
        Empty => "empty"
        BadDigit(d) => "bad digit {d}"
    }
}

fn digit(s: str, i: int) -> Result<int, ParseError> {
    let b = s.byteAt(i)
    if b < 48 || b > 57 {
        return Err(ParseError.BadDigit(s.slice(i, i + 1)))
    }
    return Ok(b - 48)
}

fn parse(s: str) -> Result<int, ParseError> {
    if s.len() == 0 {
        return Err(ParseError.Empty)
    }
    var n = 0
    for i in 0..s.len() {
        n = n * 10 + digit(s, i)?
    }
    return Ok(n)
}

fn shown(n: int) -> str {
    let r = match n {
        0 => null
        _ => if n < 0 { Err("neg") } else { Ok(n * 2) }
    }
    return match r {
        null => "null"
        Ok(v) => "Ok({v})"
        Err(e) => "Err({e})"
    }
}

fn main() -> int {
    match parse("21") {
        Ok(v) => print("{v} ok")
        Err(e) => print("error: {describe(e)}")
    }
    match parse("2x") {
        Ok(v) => print("{v} ok")
        Err(e) => print("error: {describe(e)}")
    }
    let r: Result<int, ParseError> = Ok(7)
    let bad = parse("")
    print("{r.unwrap()} {bad.unwrapOr(0)} {r.isOk()} {bad.isOk()}")
    let some: int? = 5
    let none: int? = null
    print("{some.unwrap()} {none.unwrapOr(9)}")
    print("{shown(-1)} {shown(2)} {shown(0)}")
    return 0
}
