// expect: 3 alice 2 shared
// expect: qualified 5 7
// expect: whole 3 1 4
package app

import geo.Point
import geo.{distance}
import text.*
import geo.Origin as Zero
import org.quartzlang.data as d
import org.quartzlang.math

fn main() -> int {
    let p = Point(3, 4)
    print("{distance(Zero, p)} {shout("alice")} {count()} {helper()}")
    let q = geo.Point(6, 1)
    print("qualified {geo.distance(geo.Origin, q)} {text.count() + 5}")
    let v: d.Value = d.parseJson("[1, 2, 3]").unwrapOr(d.Value.Null)
    print("whole {v.len()} {v.item(0)?.asInt() ?? 0} {math.max(4, -9)}")
    return 0
}

fn helper() -> str {
    return "shared"
}

// file: geo.qz
package geo

import org.quartzlang.math.{abs, max}

pub struct Point {
    x: int
    y: int
}

pub const Origin = Point(0, 0)

pub fn distance(a: Point, b: Point) -> int {
    return max(abs(b.x - a.x), abs(b.y - a.y)) - 1
}

fn secret() -> int {
    return 1
}

// file: text.qz
package text

pub fn shout(s: str) -> str {
    return s.lower()
}

pub fn count() -> int {
    return calls + 2
}

const calls = 0

// file: app2.qz
package app

fn other() -> int {
    return 7
}
