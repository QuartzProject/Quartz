// Reads a TOML configuration into typed structs: defaults fill missing keys, and a bad value names its line.
package org.quartzlang.examples.config

import org.quartzlang.data.*

@derive(Decode, Encode, Show)
enum Difficulty {
    Peaceful
    Normal
    Hard
}

@derive(Decode, Encode, Show)
struct World {
    name: str
    seed: int = 0
    difficulty: Difficulty = Difficulty.Normal
}

@derive(Decode, Encode)
struct Config {
    name: str = "server"
    @key("max-players")
    maxPlayers: int = 20
    motd: str = "Welcome!"
    whitelist: [str] = []
    worlds: [World] = []
}

fn load(text: str) -> Result<Config, str> {
    let config = match decodeToml::<Config>(text) {
        Ok(c) => c
        Err(e) => return Err(e.message())
    }
    if config.maxPlayers < 1 || config.maxPlayers > 1000 {
        return Err("max-players must be between 1 and 1000, found {config.maxPlayers}")
    }
    return Ok(config)
}

fn main() -> int {
    let text = "name = \"lobby\"\nmax-players = 64\nwhitelist = [\"ada\", \"bo\"]\n\n[[worlds]]\nname = \"spawn\"\ndifficulty = \"peaceful\"\n"
    match load(text) {
        Ok(c) => {
            print("{c.name}: {c.maxPlayers} players, motd '{c.motd}', whitelist {c.whitelist.join(", ")}")
            print("worlds {c.worlds}")
            print(encodeToml(c).unwrap())
        }
        Err(e) => print("bad config: {e}")
    }
    match load("max-players = 5000\n") {
        Ok(c) => print("loaded {c.name}")
        Err(e) => print("bad config: {e}")
    }
    match load("name = \"lobby\"\n\n[[worlds]]\nname = \"spawn\"\nseed = \"random\"\n") {
        Ok(c) => print("loaded {c.name}")
        Err(e) => print("bad config: {e}")
    }
    return 0
}
