package org.basaltmc.examples.math

struct Vec3 {
    x: float
    y: float
    z: float
}

impl Vec3 {
    fn lengthSquared(self) -> float {
        return self.x * self.x + self.y * self.y + self.z * self.z
    }
}

fn sumSquares(nums: [int]) -> int {
    var total = 0
    for n in nums {
        total += n * n
    }
    return total
}
